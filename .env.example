# ── Meta Marketing API ── (이 파일을 .env 로 복사해서 값 채우기)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_PAGE_ID=
# 구매/리드 최적화(OUTCOME_SALES/LEADS)에 필요. 없으면 트래픽 캠페인만 가능
META_PIXEL_ID=
# 인스타그램 계정 연결 시(선택)
META_INSTAGRAM_USER_ID=
META_API_VERSION=v24.0

# ── 안전장치 ──
# 캠페인 일예산 상한 — 계정 통화 최소단위 (USD=센트: 3500=$35 / KRW=원)
MAX_DAILY_BUDGET=8000
# 집행 중 캠페인 일예산 합계 상한 (25000 = $250/일)
MAX_TOTAL_DAILY_BUDGET=25000
DEFAULT_COUNTRY=KR
# 성과 판단 최소 지출 (계정 통화 기본단위, USD=달러)
MIN_SPEND_FOR_JUDGEMENT=10
# 결과(리드)가 이 건수 미만이면 판단 보류 — 우연을 실력으로 착각하지 않도록
MIN_RESULTS_FOR_JUDGEMENT=20
# 상담 통합 대시보드 DB (내원·수술 결과 연결)
CONSULT_DB=C:\startcording\consult_dashboard\data\consultations.db

# ── 소재 자동 생성 ──
# 기본: 이 PC에 로그인된 Claude 구독(Claude Code)으로 생성 → API 비용 없음
COPY_BACKEND=subscription
COPY_MODEL=opus
# API로 바꾸려면 COPY_BACKEND=api 로 바꾸고 키 입력
ANTHROPIC_API_KEY=
