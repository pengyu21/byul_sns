# ── Meta Marketing API ── (이 파일을 .env 로 복사해서 값 채우기)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_PAGE_ID=
# 구매/리드 최적화(OUTCOME_SALES/LEADS)에 필요. 없으면 트래픽 캠페인만 가능
META_PIXEL_ID=
# 인스타그램 계정 연결 시(선택)
META_INSTAGRAM_USER_ID=
META_API_VERSION=v24.0

# ── 안전장치 ──
# 캠페인 일예산 상한 — 계정 통화 최소단위 (USD=센트: 3500=$35 / KRW=원)
MAX_DAILY_BUDGET=3500
DEFAULT_COUNTRY=KR
# 성과 판단 최소 지출 (계정 통화 기본단위, USD=달러)
MIN_SPEND_FOR_JUDGEMENT=10
